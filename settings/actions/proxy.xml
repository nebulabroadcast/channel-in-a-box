<?xml version="1.0" encoding="UTF-8"?>
<settings>
    <allow_if>True</allow_if>
    <create_if>
      <![CDATA[(
      asset["content_type"] == ContentType.VIDEO 
      and asset["status"] == ObjectStatus.ONLINE
      )]]>
    </create_if>
    <start_if>
      <![CDATA[(
      asset["status"] == ObjectStatus.ONLINE 
      and "video/codec" in asset.meta
      )]]>
    </start_if>
    <skip_if>asset.has_proxy</skip_if>
    <task mode="ffmpeg">
        <param name="pix_fmt">"yuv420p"</param>
        <param name="c:v">"libx264"</param>
        <param name="filter:v">
        <![CDATA[
          FilterChain(
          "scale=960:-1", 
          Overlay(font_file="/mnt/nebula_01/fonts.dir/jb.ttf", font_size=18, box_border_w=6)
            .timecode(position=7, start_tc="00:00:00:00", rate=asset["video/fps"])
            .label(asset.title, position=9)
          )
        ]]>
        </param>
        <param name="profile:v">"main"</param>
        <param name="preset:v">"fast"</param>
        <param name="g">12</param>
        <param name="c:a">"aac"</param>
        <param name="b:a">"128k"</param>
        <param name="ar">48000</param>
        <param name="q:v">18</param>
        <param name='movflags'>"faststart"</param>
        <output storage="asset.proxy_storage">asset.proxy_path</output>
    </task>
</settings>
