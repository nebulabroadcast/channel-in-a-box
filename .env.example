# Everything here is optional - the stack runs without a .env file.

# Hostname or IP address clients use to reach the web interface.
# Defaults to localhost; set it to the machine's LAN IP / hostname
# to access Nebula from other computers.
# NEBULA_HOST=localhost

# Optional hardware overrides (see README):
# COMPOSE_FILE=compose.yml:compose.nvidia.yml
# COMPOSE_FILE=compose.yml:compose.blackmagic.yml

# Development: uncomment to run local source code instead of the code
# baked into the images.
# COMPOSE_FILE=compose.yml:compose.dev.yml
# NEBULA_SERVER_PATH=./nebula-server/backend
# NEBULA_WORKER_PATH=./nebula-worker
