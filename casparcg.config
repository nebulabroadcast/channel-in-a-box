<?xml version="1.0" encoding="utf-8"?>

<configuration>
    <paths>
        <media-path>/storage/media.dir</media-path>
        <log-path disable="true">/storage/log.dir</log-path>
        <data-path>/storage/data.dir</data-path>
        <template-path>/storage/template.dir</template-path>
    </paths>
    <lock-clear-phrase>secret</lock-clear-phrase>
    <channels>
        <channel>
            <video-mode>720p5000</video-mode>
            <consumers>
                <!-- For SDI output, add a DeckLink consumer (see compose.blackmagic.yml):
                <decklink>
                    <device>1</device>
                    <embedded-audio>true</embedded-audio>
                </decklink>
                -->

                <!-- Preview stream to mediamtx, watch at http://localhost:8888/live -->
                <ffmpeg>
                    <path>rtsp://mediamtx:8554/live</path>
                    <args>
                      -format rtsp 
                      -rtsp_transport tcp 
                      -codec:v libx264 
                      -preset:v veryfast 
                      -tune:v zerolatency 
                      -filter:v format=yuv420p 
                      -crf:v 20 
                      -maxrate:v 8M 
                      -bufsize:v 8M 
                      -g:v 12 
                      -codec:a aac 
                      -b:a 192k 
                      -filter:a aformat=channel_layouts=stereo
                    </args>
                    <realtime>true</realtime>
                </ffmpeg>

            </consumers>
        </channel>
    </channels>
    <osc>
      <predefined-clients>
        <predefined-client>
          <address>172.44.0.10</address>
          <port>6251</port>
        </predefined-client>
      </predefined-clients>
    </osc>
    <controllers>
        <tcp>
            <port>5250</port>
            <protocol>AMCP</protocol>
        </tcp>
    </controllers>
</configuration>
